# ============================================================
# TrueBuddy Docker 部署环境变量模板
# 用法：bash deploy/deploy.sh 会自动复制本文件为仓库根 .env；
#      脚本会把 PUBLIC_HOST=__AUTO_IP__ 替换为探测到的局域网 IP。
# 说明：占位值仅保证容器能启动；涉及 AI 的能力需替换为真实密钥。
# 变量名口径以 backend/tb-server/src/main/resources/application.yml 为准。
# ============================================================

# ---------- 通用 / 镜像 ----------
# 留空走 Docker Hub 官方仓库；受限网络可填 docker.1ms.run/library/ 或 docker.m.daocloud.io/library/
REGISTRY_PREFIX=
NPM_REGISTRY=https://registry.npmjs.org/
# 受限网络可填镜像源，留空走官方源
MAVEN_MIRROR_URL=
PIP_INDEX_URL=
# 也可直接覆盖第三方服务镜像（例如走可达镜像站）
DB_IMAGE=pgvector/pgvector:pg16
MINIO_IMAGE=minio/minio:latest
LIVEKIT_IMAGE=livekit/livekit-server:v1.9.12
# 国内可达的 MinIO 镜像示例（docker.aityp.com 详情页给出的 SWR 地址）：
# MINIO_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/minio/minio:RELEASE.2025-09-07T16-13-09Z

# 浏览器与容器都能访问的宿主机地址；__AUTO_IP__ 由 deploy.sh 自动探测替换
# 不要填 localhost：容器内的 localhost 指向容器自身
PUBLIC_HOST=__AUTO_IP__
FRONTEND_PORT=8080
BACKEND_PORT=8086
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---------- Spring Boot 数据源（宽松绑定名，缺键启动失败）----------
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
# SPRING_DATASOURCE_URL 由 compose 覆盖为 jdbc:postgresql://db:5432/tb

# ---------- 邮件（键必须存在；值可留空，功能不可用）----------
SPRING_MAIL_USERNAME=change-me@example.com
SPRING_MAIL_PASSWORD=change-me

# ---------- 对话模型 / 向量化 ----------
SPRING_AI_OPENAI_API_KEY=change-me
SPRING_AI_OPENAI_BASE_URL=https://api.deepseek.com
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=deepseek-chat
OPENAI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
OPENAI_EMBEDDING_API_KEY=change-me
OPENAI_EMBEDDING_MODEL=text-embedding-v3

# ---------- 阿里云 DocMind（KEY 缺失或 AK/SK 为空串会启动失败）----------
DOCMIND_ENDPOINT=docmind-api.cn-hangzhou.aliyuncs.com
DOCMIND_ACCESS_KEY_ID=change-me
DOCMIND_ACCESS_KEY_SECRET=change-me
DOCMIND_LLM_ENHANCEMENT=false
DOCMIND_ENHANCEMENT_MODE=
DOCMIND_FORMULA_ENHANCEMENT=false
DOCMIND_OUTPUT_HTML_TABLE=true

# ---------- 会议 / LiveKit（已纳入 compose 编排）----------
# TB_MEETING_PUBLIC_BASE_URL 由 compose 覆盖为 http://${PUBLIC_HOST}:${FRONTEND_PORT}
# LIVEKIT_URL 由 compose 覆盖为 ws://${PUBLIC_HOST}:${LIVEKIT_PORT}
TB_MEETING_PUBLIC_BASE_URL=
TB_MEETING_FRONTEND_PORT=8080
LIVEKIT_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me

# ---------- AI 数字人播报 ----------
TB_DH_ENABLED=false
DASHSCOPE_API_KEY=change-me
TB_DH_TTS_MODEL=cosyvoice-v3-flash
TB_DH_TTS_VOICE=longanyang
TB_DH_PUBLIC_BASE_URL=

# ---------- MinIO ----------
# MINIO_ENDPOINT / MINIO_PUBLIC_BASE_URL 由 compose 覆盖为宿主机可达地址
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=change-me-please
MINIO_BUCKET=test-bucket

# ---------- 其它可选 ----------
TB_DOCTEMPLATE_TEMP_DIR=/app/data/tb-doctemplate
