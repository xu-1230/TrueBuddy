        <dependency>
            <groupId>org.example</groupId>
            <artifactId>tb-spring-boot-starter-web</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 统一返回对象 CommonResult -->
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>tb-common</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 基础设施模块：复用通用文件存储（MinIO）与 infra_file 元数据 -->
