<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.example</groupId>
        <artifactId>backend</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>tb-module-test2</artifactId>
    <name>tb-module-test2</name>
    <description>测试模块2：接口功能连通性验证</description>

    <dependencies>
        <!-- Web 组件：提供 spring-boot-starter-web 注解 + tb-common 的 CommonResult -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-pdf-document-reader</artifactId>
            <version>2.0.0-M3</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-jsoup-document-reader</artifactId>
            <version>2.0.0-M3</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-markdown-document-reader</artifactId>
            <version>2.0.0-M3</version>
        </dependency>
        <!-- Apache POI for PPTX parsing
             版本与 Tika 3.2.3（经 spring-ai-tika-document-reader 传递）对齐：
             显式钉住旧版本会让 Tika 的 Office 解析器在运行时 NoSuchMethodError -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.1</version>
        </dependency>
        <!-- Tika 文档读取器：把 pdf/doc/docx/ppt/pptx/xls/xlsx/txt/md/html 统一提取为纯文本 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-tika-document-reader</artifactId>
            <version>2.0.0-M3</version>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>tb-spring-boot-starter-web</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 知识库模块：复用解析网关（阿里云文档智能）与 Markdown 分片能力做连通性验证 -->
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>tb-module-knowledgebase</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 作业模块：复用 HomeworkGradeReqVO / HomeworkFileItemVO（同时传递获得 infra 的 MinIO 读写与 MyBatis Mapper） -->
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>tb-module-homework</artifactId>
            <version>${revision}</version>
        </dependency>
    </dependencies>
</project>