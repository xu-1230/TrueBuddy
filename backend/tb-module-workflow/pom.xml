<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.example</groupId>
        <artifactId>backend</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>tb-module-workflow</artifactId>
    <name>tb-module-workflow</name>
    <description>自定义工作流模块：流程定义（workflow 表 / classpath text.json）→ spring-ai-alibaba-graph 可执行图，SSE 推送节点执行进度</description>

    <dependencies>
        <!--
          Web 组件：传递引入 spring-boot-starter-web、tb-common、hutool-all、lombok，
          提供 SseEmitter、CommonResult、ServiceException 等基础能力。
        -->
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>tb-spring-boot-starter-web</artifactId>
            <version>${revision}</version>
        </dependency>

        <!--
          工作流引擎：Spring AI Alibaba Graph。
          版本说明：2.0 线仅发布 2.0.0-M1.1（编译期面向 Spring AI 2.0.0-M1）；
          本项目由 spring-ai-bom 2.0.0-M3 统一管理 spring-ai 构件版本，故运行时实际使用 M3。
          graph-core 未纳入 tb-dependencies BOM（避免影响其它模块），版本在此显式声明。
        -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-graph-core</artifactId>
            <version>2.0.0-M1.1</version>
            <exclusions>
                <!--
                  graph-core 传递依赖 io.modelcontextprotocol.sdk:mcp（0.14.0，非 optional），
                  而本项目 spring-ai-mcp 2.0.0-M3 需要 mcp 1.1.0（doctemplate 的 docx-mcp 链路依赖它）。
                  本模块不使用 graph 的 MCP 能力，直接排除该传递依赖，避免全项目 MCP SDK 被降级。
                -->
                <exclusion>
                    <groupId>io.modelcontextprotocol.sdk</groupId>
                    <artifactId>mcp</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 数据访问：流程定义从 workflow 表读取，单表只读查询直接用 JdbcTemplate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!--
          登录态工具：/chat 是要求登录的执行入口，工作流会话 / 执行实例都要记 creator（system_user.id）。
          SecurityFrameworkUtils / LoginUser 位于该 starter，tb-common 里没有，故编译期必须显式声明；
          运行时该 jar 已由 tb-module-test 传递进 tb-server，模块间不会产生重复的自动配置。
        -->
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>tb-spring-boot-starter-security</artifactId>
            <version>${revision}</version>
        </dependency>

        <!--
          作业模块：开始节点的模拟文件树用 HomeworkFileItemVO 承载（与 POST /homework/grade 的
          files 元素同格式），大模型才能从文件清单里拿到 fileId 去调 read_homework_file_text。
          单向依赖，作业模块不依赖本模块，无循环。
        -->
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>tb-module-homework</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- Lombok：@Data / @Slf4j（版本由 Spring Boot 父工程管理，编译期生效） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试：流程定义来源与图引擎的冒烟用例（不依赖数据库与 Spring 容器） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
