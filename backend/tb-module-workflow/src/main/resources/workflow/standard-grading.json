      "data": {
        "label": "学生名单与批改方案规划",
        "system": "<role>你是一名教务作业批改的规划助手。</role>\n<task>把提交的文件树归组成「学生 → 该学生本次提交的全部文件」，并把教师给出的批改要求拆成可执行的批改方案。</task>\n<constraints>\n1. 只依据文件树判断学生归属，不要臆造学生；\n2. 每个文件必须原样保留 fileId，下游只能凭 fileId 读取文件原文；\n3. 同一学生的多份提交（代码 / 报告 / 附件）必须归到同一个学生的 files 里，不要拆成多个学生；\n4. 无法归属到任何学生的文件不要放进结果；\n5. plan 必须写全这几项：评分维度与各维度分值、满分、及格线、扣分要点、等级阈值判定规则；**必须使用给定的 score_min / score_max / pass_score**，不得改用 100 分制或其它值；各维度分值之和必须等于 score_max；\n6. custom_fields 是老师定义的自定义导出列：每一列都是逐学生输出，由评分节点按描述产出；plan 里说明本次会产出哪些列。\n</constraints>",
        "user": "## 教师批改要求\n{{description}}\n\n## 评分区间\n最低分：{{score_min}}\n满分：{{score_max}}\n及格线：{{pass_score}}\n\n## 自定义导出列\n{{custom_fields}}\n\n## 提交文件树\n{{file_tree}}\n\n请输出 student_list 与 plan。",
        "inputs": [
          {
            "name": "file_tree",
            "type": "list",
            "schema": {
              "type": "object"
            },
            "input": {
              "type": "list",
              "blockID": "100001",
              "name": "file_tree"
            }
          },
          {
            "name": "description",
            "input": {
              "type": "string",
              "blockID": "100001",
              "name": "description"
            }
          },
          {
            "name": "score_min",
            "input": {
              "type": "number",
              "blockID": "100001",
              "name": "score_min"
            }
          },
          {
            "name": "score_max",
            "input": {
              "type": "number",
              "blockID": "100001",
              "name": "score_max"
            }
          },
          {
            "name": "pass_score",
            "input": {
              "type": "number",
              "blockID": "100001",
              "name": "pass_score"
            }
          },
          {
            "name": "custom_fields",
            "type": "list",
            "schema": {
              "type": "object"
            },
            "input": {
              "type": "list",
              "blockID": "100001",
              "name": "custom_fields"
            }
          }
        ],
        "outputs": [
          {
            "name": "student_list",
            "type": "list",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "student": {
                  "type": "string",
                  "description": "学生姓名"
                },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "description": "文件路径"
                      },
                      "fileId": {
                        "type": "integer",
                        "description": "文件 id，用于读取原文"
                      },
                      "name": {
                        "type": "string",
                        "description": "文件名"
                      }
                    },
                    "required": [
                      "path",
                      "fileId"
                    ]
                  },
                  "description": "该学生本次提交的全部文件"
                }
              },
              "required": [
                "student",
                "files"
              ]
            },
            "description": "学生名单：每个元素形如 {student, files:[{path, fileId, name}]}"
          },
          {
            "name": "plan",
            "type": "string",
            "required": true,
            "description": "批改方案：评分维度与分值、满分、及格线、扣分要点、等级阈值"
          }
        ]
      }
