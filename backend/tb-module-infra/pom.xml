<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.example</groupId>
        <artifactId>backend</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>tb-module-infra</artifactId>
    <name>tb-module-infra</name>
    <description>基础设施模块：通用文件上传（MinIO 对象存储 + infra_file 元数据）</description>

    <dependencies>
        <!-- Web 组件：提供 spring-boot-starter-web 注解（MultipartFile / @RestController） + CommonResult -->
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>tb-spring-boot-starter-web</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 统一返回对象 CommonResult -->
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>tb-common</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 数据访问：与 tb-module-knowledgebase 保持一致，使用 MyBatis 注解 Mapper -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <!-- MinIO 对象存储 -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.10</version>
        </dependency>
        <!-- 邮件发送（注册验证码、找回密码等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
    </dependencies>
</project>
