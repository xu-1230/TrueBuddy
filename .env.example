# ============================================================
# TrueBuddy 环境变量名清单（2026-11-13 起：真实值统一在 backend/.env）
# ------------------------------------------------------------
# application.yml 只保留 ${VAR} 占位符；真实值统一放 backend/.env（已被
# .gitignore 忽略、不进版本库），由 Spring 经 spring.config.import 自动
# 加载（docs/adr/0005）。仓库根的 .env 仍不被 Spring 加载（仅 IDE EnvFile
# 插件可能读它）。本文件用作变量名清单：重新克隆 / 换机时对照准备 backend/.env。
#
# 本文件保留两个用途：
#   1) 查可用的变量名 —— 这些名字作为**环境变量**仍可临时覆盖 yml 里的值（优先级高于配置文件）
#      例：$env:LIVEKIT_API_KEY='…' 之后再启动后端，无需改 yml
#   2) 查各变量的默认值与行为说明
#
# 例外：digital-human-worker/ 侧的 Node 进程只读**同目录** .env，见 digital-human-worker/.env.example；
#       其 AGENT_SHARED_SECRET 必须与 yml 里 tb.lecture.digital-human.agent-shared-secret 同值。
#       （2026-10-10：worker 已删除，这条例外不再适用，见 docs/16 §5.7）
#
# 口径与演变见 docs/doc-devops.md §2 / §3 与 docs/adr/0005。
# ============================================================

# ---------- 阿里云文档智能 · 文档解析大模型版（必填） ----------
# 缺失时后端启动即失败（DocMindProperties.missingCredentials 校验）
DOCMIND_ACCESS_KEY_ID=
DOCMIND_ACCESS_KEY_SECRET=
# 以下为可选项，留空则使用 application.yml 中的默认值
# DOCMIND_ENDPOINT=docmind-api.cn-hangzhou.aliyuncs.com
# DOCMIND_LLM_ENHANCEMENT=false
# DOCMIND_ENHANCEMENT_MODE=
# DOCMIND_FORMULA_ENHANCEMENT=false
# 表格输出 HTML 正文；接口要求必须同时 DOCMIND_LLM_ENHANCEMENT=true，否则提交报 Parameter is invalid
DOCMIND_OUTPUT_HTML_TABLE=true

# ---------- 对话模型 / 文档模板生成（必填） ----------
# OpenAI 兼容接口的密钥（当前默认走 DeepSeek）
OPENAI_API_KEY=
# 以下为可选项，留空则使用 application.yml 中的默认值
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_CHAT_MODEL=deepseek-flash

# ---------- 文本向量化 / 知识库 RAG（必填） ----------
# 当前默认走阿里云百炼（DashScope）兼容模式
OPENAI_EMBEDDING_API_KEY=
# 以下为可选项，留空则使用 application.yml 中的默认值
# OPENAI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# OPENAI_EMBEDDING_MODEL=text-embedding-v3

# ---------- LiveKit（模拟会议实时通道；服务端部署在 D:\ctf\livekit） ----------
# 与 D:\ctf\livekit\.env 的 LIVEKIT_API_KEY / LIVEKIT_API_SECRET 必须一致（启动 LiveKit 用同一对值）
# 留空时：会议可创建、可查历史，但学生入会会被明确拒绝（错误码 1_007_000_010），不会静默失败
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# 以下为可选项，留空则使用 application.yml 中的默认值
# 信令地址留空时按 ws://{本机局域网IP}:{端口} 推导（答辩现场走手机热点，IP 每次可能变化）
# LIVEKIT_URL=ws://192.168.43.1:7880
# LIVEKIT_PORT=7880
# LIVEKIT_TOKEN_TTL_HOURS=6

# ---------- AI 数字人播报（见 docs/doc-lecture.md §5.7；默认开启，缺 Key 时前端显示「语音不可用」） ----------
# CosyVoice 走 DashScope 原生 WebSocket，可与上面 embedding 用同一个百炼 Key
DASHSCOPE_API_KEY=
# 总开关：true 才允许 /ppt/speech/speak 取流
TB_DH_ENABLED=true
# 以下为可选项，留空则使用 application.yml 中的默认值
# TB_DH_TTS_MODEL=cosyvoice-v3-flash
# TB_DH_TTS_VOICE=longanyang
# TB_DH_MAX_SPEAK=2
# TB_DH_MAX_TEXT_LENGTH=1000

# ---------- MinIO 对象存储（密钥必填） ----------
MINIO_SECRET_KEY=
# 以下为可选项，留空则使用默认值
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=admin
# MINIO_BUCKET=test-bucket

# ---------- PostgreSQL ----------
# yml 引用的是宽松绑定名 SPRING_DATASOURCE_USERNAME / SPRING_DATASOURCE_PASSWORD
# （真实值在 backend/.env，本地为 postgres / 空密码）；下列语义名不被引用：
# DB_USERNAME=postgres
# DB_PASSWORD=

# ---------- 文档模板生成（可选） ----------
# TB_DOCTEMPLATE_TEMP_DIR=
