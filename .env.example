# ============================================================
# TrueBuddy 环境变量模板
# ------------------------------------------------------------
# 用法：复制为 .env 并填入真实值，然后按需导出到当前终端。
#
#   Windows PowerShell（当前会话）：
#     Get-Content .env | Where-Object { $_ -match '^\s*[^#].*=' } | ForEach-Object {
#       $name, $value = $_ -split '=', 2
#       Set-Item -Path ('Env:' + $name.Trim()) -Value $value.Trim()
#     }
#   或直接使用：backend\run-dev.cmd（自动读取本文件后启动后端）
#
#   Linux / macOS：
#     set -a; source .env; set +a
#
# 注意：.env 已被 .gitignore 忽略，禁止提交真实密钥到仓库。
# ============================================================

# ---------- PostgreSQL（必填，无默认值） ----------
DB_USERNAME=postgres
DB_PASSWORD=

# ---------- 对话模型 / 文档模板生成（必填，无默认值） ----------
# OpenAI 兼容接口的密钥（当前默认走 DeepSeek）
OPENAI_API_KEY=
# 以下为可选项，留空则使用 application.yml 中的默认值
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_CHAT_MODEL=deepseek-flash

# ---------- 文本向量化 / 知识库 RAG（必填，无默认值） ----------
# 当前默认走阿里云百炼（DashScope）兼容模式
OPENAI_EMBEDDING_API_KEY=
# 以下为可选项，留空则使用 application.yml 中的默认值
# OPENAI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# OPENAI_EMBEDDING_MODEL=text-embedding-v3

# ---------- MinIO 对象存储（密钥必填，无默认值） ----------
MINIO_SECRET_KEY=
# 以下为可选项，留空则使用默认值
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=admin
# MINIO_BUCKET=test-bucket
