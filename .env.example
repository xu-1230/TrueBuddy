# ============================================================
# TrueBuddy 环境变量模板
# ------------------------------------------------------------
# 用法：复制为项目根目录的 .env 并填入真实值。
#   后端 application.yml 已配置 spring.config.import，
#   会从工作目录逐级向上自动加载 .env，无需手动导出到终端。
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env
#
# 注意：.env 已被 .gitignore 忽略，禁止把真实密钥提交到仓库。
# ============================================================

# ---------- 阿里云文档智能 · 文档解析大模型版（必填） ----------
# 缺失时后端启动即失败（DocMindProperties.missingCredentials 校验）
DOCMIND_ACCESS_KEY_ID=
DOCMIND_ACCESS_KEY_SECRET=
# 以下为可选项，留空则使用 application.yml 中的默认值
# DOCMIND_ENDPOINT=docmind-api.cn-hangzhou.aliyuncs.com
# DOCMIND_LLM_ENHANCEMENT=false
# DOCMIND_ENHANCEMENT_MODE=
# DOCMIND_FORMULA_ENHANCEMENT=false
# 表格输出 HTML 正文；接口要求必须同时 DOCMIND_LLM_ENHANCEMENT=true，否则提交报 Parameter is invalid
DOCMIND_OUTPUT_HTML_TABLE=true

# ---------- 对话模型 / 文档模板生成（必填） ----------
# OpenAI 兼容接口的密钥（当前默认走 DeepSeek）
OPENAI_API_KEY=
# 以下为可选项，留空则使用 application.yml 中的默认值
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_CHAT_MODEL=deepseek-flash

# ---------- 文本向量化 / 知识库 RAG（必填） ----------
# 当前默认走阿里云百炼（DashScope）兼容模式
OPENAI_EMBEDDING_API_KEY=
# 以下为可选项，留空则使用 application.yml 中的默认值
# OPENAI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# OPENAI_EMBEDDING_MODEL=text-embedding-v3

# ---------- LiveKit（模拟会议实时通道；服务端部署在 D:\ctf\livekit） ----------
# 与 D:\ctf\livekit\.env 的 LIVEKIT_API_KEY / LIVEKIT_API_SECRET 必须一致（启动 LiveKit 用同一对值）
# 留空时：会议可创建、可查历史，但学生入会会被明确拒绝（错误码 1_007_000_010），不会静默失败
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# 以下为可选项，留空则使用 application.yml 中的默认值
# 信令地址留空时按 ws://{本机局域网IP}:{端口} 推导（答辩现场走手机热点，IP 每次可能变化）
# LIVEKIT_URL=ws://192.168.43.1:7880
# LIVEKIT_PORT=7880
# LIVEKIT_TOKEN_TTL_HOURS=6

# ---------- MinIO 对象存储（密钥必填） ----------
MINIO_SECRET_KEY=
# 以下为可选项，留空则使用默认值
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=admin
# MINIO_BUCKET=test-bucket

# ---------- PostgreSQL（待接入） ----------
# 现状：application.yml 中硬编码 username=postgres、password 为空（本地 trust 认证），
#       下列变量尚未被引用，属「待整改」项（见 docs/08-通用约束.md §1.3）。
# DB_USERNAME=postgres
# DB_PASSWORD=

# ---------- 文档模板生成（可选） ----------
# TB_DOCTEMPLATE_TEMP_DIR=
